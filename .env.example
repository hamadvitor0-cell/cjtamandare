NODE_ENV=development
PORT=3000

# PostgreSQL / Supabase
# Exemplo Supabase: postgresql://postgres:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
# auto desativa SSL em localhost e ativa em provedores externos. Use true para Supabase.
PGSSL=auto

# Use apenas para demonstração local sem banco. Nunca use em produção.
USE_MEMORY_STORE=false

# Segurança
JWT_SECRET=troque-por-uma-chave-com-64-caracteres-ou-mais
COOKIE_SECRET=troque-por-outra-chave-com-64-caracteres-ou-mais
JWT_EXPIRES_IN=2h
COOKIE_SAME_SITE=strict
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
LOG_TO_FILE=false
AUTO_MIGRATE=false
# Execute DDL/backfills apenas em uma etapa controlada. Mantenha false na execucao normal de producao.
RUNTIME_DATABASE_SETUP=false

# Limitacao distribuida de abuso. Em producao, use redis (preferido) ou postgres.
RATE_LIMIT_STORE=memory
# No Vercel/Upstash, use as variaveis injetadas pela integracao ou copie para estes nomes canonicos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pepper exclusivo do servidor para impedir CPF/matricula em claro nas chaves de limite.
RATE_LIMIT_KEY_PEPPER=

# O puzzle CAPTCHA e assinado com COOKIE_SECRET e nao exige chaves externas.

# IA / Vercel AI Gateway
# A IA real so funciona quando o AI Gateway estiver habilitado no projeto da Vercel.
AI_FEATURES_ENABLED=false
AI_MODEL=openai/gpt-5.4
AI_REQUEST_TIMEOUT_MS=6500
# Para teste local, use a chave do AI Gateway se necessario.
AI_GATEWAY_API_KEY=

# Administrador inicial. Rode: npm run seed:admin
ADMIN_NAME=Administrador
ADMIN_USERNAME=master
# Defina um codigo exclusivo de 6 digitos apenas no ambiente seguro antes de executar o seed.
ADMIN_REGISTRATION_CODE=
ADMIN_RESET_ADMINS=false
# Opcional, mantido apenas para localizar/atualizar um master antigo por e-mail.
ADMIN_EMAIL=
